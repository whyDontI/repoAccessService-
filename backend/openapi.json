              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrgOut"
                  },
                  "type": "array",
                  "title": "Response List Orgs Orgs Get"
                }
              }
            }
          }
        }
      }
    },
    "/orgs/{org_id}/repos": {
