  },
  "components": {
    "schemas": {
      "CheckResponse": {
        "properties": {
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          }
        },
        "type": "object",
        "required": [
          "allowed",
          "as_of"
        ],
        "title": "CheckResponse",
        "description": "as_of is when the user's cached team set was computed, if this was\na cache hit -- None on a cold check. Grants are always read live, so\nthis is the only source of staleness in a check() answer at all."
      },
      "ExplainResponse": {
        "properties": {
          "allowed": {
            "type": "boolean",
            "title": "Allowed"
          },
          "chain": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Chain"
          },
          "granted_role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Role"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "allowed",
          "chain",
          "granted_role"
        ],
        "title": "ExplainResponse",
        "description": "chain is a readable breadcrumb, e.g.\n[\"alice\", \"platform-eng\", \"infrastructure\", \"acme-corp (write)\", \"repo: api-gateway\"].\nreason is only set on a deny -- see checker.explain."
      },
      "GrantIn": {
        "properties": {
          "subject_id": {
            "type": "integer",
            "title": "Subject Id"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "resource_id": {
            "type": "integer",
            "title": "Resource Id"
          }
        },
        "type": "object",
        "required": [
          "subject_id",
          "role",
          "resource_id"
        ],
        "title": "GrantIn"
      },
      "GrantOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "subject_id": {
            "type": "integer",
            "title": "Subject Id"
          },
          "subject_name": {
            "type": "string",
            "title": "Subject Name"
          },
          "subject_type": {
            "type": "string",
            "enum": [
              "user",
              "team"
            ],
            "title": "Subject Type"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "resource_id": {
            "type": "integer",
            "title": "Resource Id"
          },
          "resource_name": {
            "type": "string",
            "title": "Resource Name"
          },
          "resource_type": {
            "type": "string",
            "enum": [
              "org",
              "repo"
            ],
            "title": "Resource Type"
          }
        },
        "type": "object",
        "required": [
          "id",
          "subject_id",
          "subject_name",
          "subject_type",
          "role",
          "resource_id",
          "resource_name",
          "resource_type"
        ],
        "title": "GrantOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MembershipIn": {
        "properties": {
          "subject_id": {
            "type": "integer",
            "title": "Subject Id"
          },
          "belongs_to_team_id": {
            "type": "integer",
            "title": "Belongs To Team Id"
          }
        },
        "type": "object",
        "required": [
          "subject_id",
          "belongs_to_team_id"
        ],
        "title": "MembershipIn"
      },
      "OrgOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "OrgOut"
      },
      "RepoOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "org_id": {
            "type": "integer",
            "title": "Org Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "org_id"
        ],
        "title": "RepoOut"
      },
      "ResourceOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "org",
              "repo"
            ],
            "title": "Type"
          },
          "org_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "org_id"
        ],
        "title": "ResourceOut"
      },
      "Role": {
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          4
        ],
        "title": "Role",
        "description": "Ordered so `role >= action` just works: higher roles imply lower ones."
      },
      "SubjectRef": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "user",
              "team"
            ],
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "type"
        ],
        "title": "SubjectRef",
        "description": "A minimal reference to a user or team, used for a team's parent\nand children -- just enough to link to it, show a name, and tell a\nuser apart from a nested team when rendering as a tree."
      },
      "TeamOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "parent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubjectRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/SubjectRef"
            },
            "type": "array",
            "title": "Children"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "parent",
          "children"
        ],
        "title": "TeamOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
